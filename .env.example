# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL connection string (required for full local submission testing)
# Local Docker database (compose.local.yml): host 127.0.0.1, port 3306,
# database packsendgo_local, user packsendgo_app. Place the real connection
# string in `.env.local` only — never commit passwords or DATABASE_URL here.
# Example shape (replace YOUR_APP_PASSWORD with the value from .env.mysql.local):
# DATABASE_URL="mysql://packsendgo_app:YOUR_APP_PASSWORD@127.0.0.1:3306/packsendgo_local"
DATABASE_URL=

# Cloudflare Turnstile (required in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Development-only Turnstile bypass (must remain unset in production)
TURNSTILE_BYPASS_DEV=false

# Transactional email (required in production; pending Product Owner/provider input)
EMAIL_FROM=
QUOTE_NOTIFICATION_EMAIL=
