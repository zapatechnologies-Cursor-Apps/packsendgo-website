# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL connection string (required for full local submission testing)
DATABASE_URL=

# Cloudflare Turnstile (required in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Development-only Turnstile bypass (must remain unset in production)
TURNSTILE_BYPASS_DEV=false

# Transactional email (required in production; pending Product Owner/provider input)
EMAIL_FROM=
QUOTE_NOTIFICATION_EMAIL=
