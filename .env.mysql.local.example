# PackSendGo local MySQL credentials — EXAMPLE ONLY
#
# Copy this file to `.env.mysql.local` and replace every placeholder with
# randomly generated passwords. Do not reuse production or staging credentials.
#
# `.env.mysql.local` is local-only and ignored by Git.
# The Next.js application reads `DATABASE_URL` from `.env.local`, not this file.
#
# Generate passwords with a password manager or, for example:
#   openssl rand -base64 32
#
# Root access is for container initialisation and local administration only.
# The application must connect with the restricted user `packsendgo_app`.

MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MYSQL_DATABASE=packsendgo_local
MYSQL_USER=packsendgo_app
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
